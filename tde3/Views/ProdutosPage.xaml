<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tde3.Views.ProdutosPage"
             Title="Gestão de Produtos"
             BackgroundColor="#F4F6F8">

    <Grid RowDefinitions="Auto, *" MaximumWidthRequest="420" HorizontalOptions="Center" Padding="15">

        <VerticalStackLayout Grid.Row="0" Spacing="12" Margin="0,10,0,20">
            <Frame HasShadow="True" BorderColor="Transparent" CornerRadius="12" Padding="0" BackgroundColor="White">
                <Entry x:Name="NomeEntry" Placeholder="Nome do Produto" MaxLength="50" Margin="10,0" />
            </Frame>
            <Frame HasShadow="True" BorderColor="Transparent" CornerRadius="12" Padding="0" BackgroundColor="White">
                <Entry x:Name="TipoEntry" Placeholder="Tipo do Produto" MaxLength="50" Margin="10,0" />
            </Frame>
            <Frame HasShadow="True" BorderColor="Transparent" CornerRadius="12" Padding="0" BackgroundColor="White">
                <Entry x:Name="PrecoEntry" Placeholder="Preço (ex: 10,50)" Keyboard="Numeric" Margin="10,0" />
            </Frame>
            <Frame HasShadow="True" BorderColor="Transparent" CornerRadius="12" Padding="0" BackgroundColor="White">
                <Entry x:Name="EstoqueEntry" Placeholder="Quantidade em Estoque" Keyboard="Numeric" Margin="10,0" />
            </Frame>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
                <Button Text="Guardar" Clicked="OnGuardarClicked" BackgroundColor="#512BD4" TextColor="White" CornerRadius="8" FontAttributes="Bold" />
                <Button Text="Atualizar" Clicked="OnAtualizarClicked" BackgroundColor="#2B88D4" TextColor="White" CornerRadius="8" FontAttributes="Bold" />
                <Button Text="Apagar" Clicked="OnApagarClicked" BackgroundColor="#D42B2B" TextColor="White" CornerRadius="8" FontAttributes="Bold" />
                <Button Text="Limpar" Clicked="OnLimparClicked" BackgroundColor="Gray" TextColor="White" CornerRadius="8" FontAttributes="Bold" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="ProdutosListView" SelectionMode="Single" SelectionChanged="OnProdutoSelecionado">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="0,5,0,5" BorderColor="Transparent" BackgroundColor="White" HasShadow="True" CornerRadius="12">
                        <VerticalStackLayout>
                            <Label Text="{Binding NomeProduto}" FontAttributes="Bold" FontSize="16" TextColor="#2B2D42" />
                            <Label Text="{Binding Tipo, StringFormat='Tipo: {0}'}" TextColor="#6C757D" />
                            <Label Text="{Binding Preco, StringFormat='Preço: R$ {0:F2}'}" TextColor="#27AE60" FontAttributes="Bold" />
                            <Label Text="{Binding QtdEstoque, StringFormat='Estoque: {0} un'}" TextColor="#8D99AE" FontSize="12" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>